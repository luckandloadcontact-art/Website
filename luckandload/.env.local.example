# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_32chars_minimum

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Affilka (Hype.bet) affiliate stats API
AFFILKA_API_KEY=your_affilka_api_key

# Beskytter /api/cron/refresh-leaderboard -- samme verdi som GitHub Actions-secret CRON_SECRET
CRON_SECRET=your_random_secret

# YouTube Data API (News-siden) -- se setup-guiden for hvordan disse skaffes
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# Instagram (News-siden) -- brukes av "Connect Instagram"-knappen i adminpanelet (OAuth).
# Selve access-tokenen settes IKKE her -- den lagres/fornyes automatisk i databasen etter at
# admin har koblet til kontoen via knappen.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LuckAndLoadTV
